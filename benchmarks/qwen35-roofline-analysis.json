  "assumptions": [
    "Each decode batch loads every text weight and quantization auxiliary exactly once from shared memory.",
    "Each request reads and writes one FP32 GDN state and BF16 convolution state per linear layer.",
    "Attention reads each active BF16 KV element once per layer, reusing it across grouped query heads.",
    "Mean active KV length is approximated by 128 + (64 - 1) / 2 = 159.5 tokens.",
    "No cross-step persistence of weight or recurrent-state arrays in on-chip caches is modeled.",
    "Temporary activations, dequantization, reductions, CPU dispatch and synchronization costs are omitted.",
    "200 GB/s is advertised shared bandwidth, not a measured sustained GPU read bandwidth.",
    "This conditional traffic model is not an absolute hardware limit or a promise of achievable throughput."
  ],
  "formulas": {
    "aggregate_bandwidth_roof": "BW * B / (W + B * D(L))",
    "request_traffic": "D(L) = 2*S_gdn + 2*S_conv + KV_bytes_per_token*(L+1) + embedding_row_bytes",
    "combined_roof": "min(aggregate_bandwidth_roof, effective_compute_flops_per_second / decode_flops_per_token)",
    "decode_flops_per_token": "1503789056 + approximately 33030144 + 49152*L; excludes scalar nonlinear and quantization work"
